# ---- Database (PostgreSQL, Prisma) ----
# Compose default for local development:
DATABASE_URL="postgresql://erp:erp@localhost:5432/erp?schema=public"

# ---- Redis (BullMQ) ----
REDIS_URL="redis://localhost:6379"

# ---- Auth ----
# Generate e.g. with: openssl rand -hex 48
JWT_ACCESS_SECRET="change-me-generate-a-real-secret"
JWT_REFRESH_SECRET="change-me-generate-another-real-secret"
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="1209600"

# ---- CORS / URLs ----
WEB_ORIGIN="http://localhost:3000"
API_URL="http://localhost:4000"

# ---- Object storage (S3-compatible; local default = MinIO via docker compose) ----
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_BUCKET="erp-documents"
OBJECT_STORAGE_ACCESS_KEY="minioadmin"
OBJECT_STORAGE_SECRET_KEY="minioadmin"
# Use "memory" only for unit tests / ephemeral sandboxes:
OBJECT_STORAGE_DRIVER="s3"
# Fallback local-disk driver (no MinIO required):
# OBJECT_STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./data/documents"

# ---- Worker ----
OUTBOX_POLL_INTERVAL_MS="2000"
OUTBOX_BATCH_SIZE="50"

# ---- Logging ----
LOG_LEVEL="info"
