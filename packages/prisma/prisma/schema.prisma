// Enterprise Office ERP — Prisma schema (Stage 1: Foundation + Core Platform)
// Source: DATA-MODEL.md (sections 3–8, 17–23), ARCHITECTURE.md §16.
// Conventions: UUID PKs, timestamps, created_by/updated_by, organization scoping,
// exact decimals for money, explicit relations and indexes.
// Later stages (HR, Payroll, Procurement, Inventory, Sales, Accounting) extend
// this schema with their own vertical-slice migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform — Organization (DATA-MODEL §4)
// ---------------------------------------------------------------------------

model Company {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  legalName          String?
  registrationNumber String?
  taxNumber          String?
  timezone           String   @default("UTC")
  address            String?
  phone              String?
  email              String?
  website            String?
  baseCurrencyId     String?
  fiscalYearStart    Int      @default(1) // month number 1-12
  status             String   @default("ACTIVE")
  settings           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String?
  updatedById        String?

  branches         Branch[]
  departments      Department[]
  costCenters      CostCenter[]
  warehouses       Warehouse[]
  financialPeriods FinancialPeriod[]
  accounts         Account[]

  @@index([status])
}

model Branch {
  id                String   @id @default(uuid())
  companyId         String
  code              String
  name              String
  type              String?
  timezone          String   @default("UTC")
  address           String?
  phone             String?
  email             String?
  managerEmployeeId String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?
  updatedById       String?

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  departments Department[]
  warehouses  Warehouse[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model Department {
  id                String   @id @default(uuid())
  companyId         String
  branchId          String
  parentId          String?  @map("parent_department_id")
  code              String
  name              String
  managerEmployeeId String?
  costCenterId      String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?
  updatedById       String?

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentTree")

  @@unique([companyId, code])
  @@index([companyId, branchId, status])
}

model CostCenter {
  id                String   @id @default(uuid())
  companyId         String
  branchId          String?
  code              String
  name              String
  description       String?
  managerEmployeeId String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([companyId, status])
}

model Warehouse {
  id                String   @id @default(uuid())
  companyId         String
  branchId          String
  code              String
  name              String
  type              String?
  address           String?
  managerEmployeeId String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?
  updatedById       String?

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch    Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  locations WarehouseLocation[]

  @@unique([companyId, code])
  @@index([companyId, branchId, status])
}

model WarehouseLocation {
  id           String   @id @default(uuid())
  warehouseId  String
  code         String
  name         String
  parentId     String?  @map("parent_location_id")
  locationType String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  parent    WarehouseLocation?  @relation("LocationTree", fields: [parentId], references: [id])
  children  WarehouseLocation[] @relation("LocationTree")

  @@unique([warehouseId, code])
}

// ---------------------------------------------------------------------------
// Platform — Currency (DATA-MODEL §16)
// ---------------------------------------------------------------------------

model Currency {
  id            String @id @default(uuid())
  code          String @unique
  name          String
  symbol        String
  decimalPlaces Int    @default(2)
  status        String @default("ACTIVE")

  payGroups        PayGroup[]
  salaryStructures SalaryStructure[]
  salaryAssignments EmployeeSalaryAssignment[]
  payrollRuns      PayrollRun[]
  suppliers        Supplier[]
}

// ---------------------------------------------------------------------------
// Platform — Identity & Authorization (DATA-MODEL §5)
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  displayName         String
  phone               String?
  employeeId          String?   @unique @map("employee_id")
  passwordHash        String
  status              String    @default("ACTIVE") // ACTIVE | DISABLED | LOCKED
  mfaEnabled          Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String?
  updatedById         String?

  roles         UserRoleAssignment[]
  refreshTokens RefreshToken[]
  sessions      UserSession[]
  preferences   NotificationPreference[]
  employee      Employee?

  @@index([status])
}

model Role {
  id           String  @id @default(uuid())
  name         String
  code         String  @unique
  description  String?
  isSystemRole Boolean @default(false) @map("is_system_role")
  status       String  @default("ACTIVE")

  permissions RolePermission[]
  users       UserRoleAssignment[]
}

model Permission {
  id       String @id @default(uuid())
  module   String
  resource String
  action   String

  roles RolePermission[]

  @@unique([module, resource, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  id           String    @id @default(uuid())
  userId       String
  roleId       String
  companyId    String?
  branchId     String?
  departmentId String?
  warehouseId  String?
  validFrom    DateTime  @default(now())
  validTo      DateTime?
  createdAt    DateTime  @default(now())
  createdById  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roleId])
}

model UserSession {
  id             String    @id @default(uuid())
  userId         String
  refreshTokenId String?
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  family       String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, family])
}

// ---------------------------------------------------------------------------
// Platform — Financial Periods & Chart of Accounts (foundation seed needs these)
// (DATA-MODEL §12, §13)
// ---------------------------------------------------------------------------

model FinancialPeriod {
  id         String    @id @default(uuid())
  companyId  String
  fiscalYear Int
  periodNo   Int
  startDate  DateTime  @map("start_date")
  endDate    DateTime  @map("end_date")
  status     String    @default("OPEN") // OPEN | CLOSING | CLOSED
  closedById String?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, fiscalYear, periodNo])
  @@index([companyId, status])
}

model Account {
  id               String   @id @default(uuid())
  companyId        String
  parentId         String?
  accountCode      String
  accountName      String
  accountType      String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  normalBalance    String // DEBIT | CREDIT
  currencyId       String?
  isControlAccount Boolean  @default(false) @map("is_control_account")
  isPostable       Boolean  @default(true) @map("is_postable")
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent   Account?  @relation("AccountTree", fields: [parentId], references: [id])
  children Account[] @relation("AccountTree")

  @@unique([companyId, accountCode])
  @@index([companyId, accountType])
}

// ---------------------------------------------------------------------------
// Platform — Numbering (DATA-MODEL §3, ARCHITECTURE §41)
// ---------------------------------------------------------------------------

model DocumentSequence {
  id           String @id @default(uuid())
  companyId    String
  documentType String
  fiscalYear   Int
  prefix       String
  nextNumber   BigInt @default(1)

  @@unique([companyId, documentType, fiscalYear])
}

// ---------------------------------------------------------------------------
// Platform — Workflow & Approvals (DATA-MODEL §17)
// ---------------------------------------------------------------------------

model WorkflowDefinition {
  id         String  @id @default(uuid())
  companyId  String?
  name       String
  entityType String
  version    Int     @default(1)
  status     String  @default("ACTIVE")

  states      WorkflowState[]
  transitions WorkflowTransition[]
  instances   WorkflowInstance[]

  @@unique([companyId, entityType, version])
}

model WorkflowState {
  id           String  @id @default(uuid())
  definitionId String
  code         String
  name         String
  isInitial    Boolean @default(false) @map("is_initial")
  isTerminal   Boolean @default(false) @map("is_terminal")

  definition      WorkflowDefinition   @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  transitionsFrom WorkflowTransition[] @relation("TransitionFrom")
  transitionsTo   WorkflowTransition[] @relation("TransitionTo")

  @@unique([definitionId, code])
}

model WorkflowTransition {
  id           String @id @default(uuid())
  definitionId String
  fromStateId  String
  toStateId    String
  action       String
  condition    Json?

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  fromState  WorkflowState      @relation("TransitionFrom", fields: [fromStateId], references: [id], onDelete: Restrict)
  toState    WorkflowState      @relation("TransitionTo", fields: [toStateId], references: [id], onDelete: Restrict)

  @@unique([definitionId, fromStateId, action])
}

model WorkflowInstance {
  id           String    @id @default(uuid())
  definitionId String
  entityType   String
  entityId     String
  currentState String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  tasks      ApprovalTask[]

  @@unique([entityType, entityId, definitionId])
  @@index([entityType, entityId])
  @@index([currentState])
}

model ApprovalTask {
  id              String    @id @default(uuid())
  instanceId      String
  step            Int       @default(1)
  approverType    String // USER | ROLE
  approverId      String
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | CHANGES_REQUESTED | CANCELLED
  dueAt           DateTime?
  actedAt         DateTime?
  actedBy         String?
  comments        String?
  rejectionReason String?
  delegatedFrom   String?
  createdAt       DateTime  @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([approverType, approverId, status])
  @@index([status, dueAt])
}

// ---------------------------------------------------------------------------
// Platform — Documents (DATA-MODEL §18)
// ---------------------------------------------------------------------------

model Document {
  id           String   @id @default(uuid())
  companyId    String
  branchId     String?
  documentType String?
  title        String
  description  String?
  storageKey   String
  filename     String
  mimeType     String
  sizeBytes    BigInt
  contentHash  String?
  version      Int      @default(1)
  accessPolicy String   @default("COMPANY") // COMPANY | BRANCH | PRIVATE
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  links    DocumentLink[]
  versions DocumentVersion[]

  @@index([companyId, documentType])
  @@index([createdById])
}

model DocumentLink {
  id               String @id @default(uuid())
  documentId       String
  entityType       String
  entityId         String
  relationshipType String @default("ATTACHMENT")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityType, entityId, relationshipType])
  @@index([entityType, entityId])
}

model DocumentVersion {
  id           String   @id @default(uuid())
  documentId   String
  versionNo    Int
  storageKey   String
  contentHash  String?
  sizeBytes    BigInt
  uploadedById String
  uploadedAt   DateTime @default(now())
  changeReason String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo])
}

// ---------------------------------------------------------------------------
// Platform — Notifications (DATA-MODEL §20)
// ---------------------------------------------------------------------------

model Notification {
  id           String    @id @default(uuid())
  userId       String
  companyId    String?
  type         String
  title        String
  message      String
  resourceType String?
  resourceId   String?
  channel      String    @default("IN_APP")
  status       String    @default("UNREAD") // UNREAD | READ | FAILED
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@index([userId, status])
  @@index([companyId, type])
}

model NotificationDelivery {
  id                String    @id @default(uuid())
  notificationId    String
  provider          String
  attempt           Int       @default(1)
  status            String    @default("PENDING") // PENDING | SENT | FAILED
  providerReference String?
  errorCode         String?
  sentAt            DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
}

model NotificationPreference {
  id        String  @id @default(uuid())
  userId    String
  eventType String
  channel   String
  enabled   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
}

// ---------------------------------------------------------------------------
// Platform — Events / Outbox (DATA-MODEL §21)
// ---------------------------------------------------------------------------

model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  status        String    @default("PENDING") // PENDING | PUBLISHED | FAILED
  lastError     String?

  @@index([status, occurredAt])
}

// ---------------------------------------------------------------------------
// HR — Employees, Attendance, Leave, Holidays (DATA-MODEL §6, §7)
// ---------------------------------------------------------------------------

model Employee {
  id                String    @id @default(uuid())
  companyId         String
  branchId          String?
  departmentId      String?
  employeeNo        String
  userId            String?   @unique
  firstName         String
  middleName        String?
  lastName          String
  displayName       String
  gender            String?
  dateOfBirth       DateTime? @db.Date
  nationality       String?
  nationalId        String?
  email             String?
  phone             String?
  address           String?
  hireDate          DateTime  @db.Date
  terminationDate   DateTime? @db.Date
  employmentStatus  String    @default("DRAFT") // DRAFT | ACTIVE | ON_LEAVE | SUSPENDED | TERMINATED | RETIRED
  employmentType    String? // FULL_TIME | PART_TIME | CONTRACT | INTERN
  jobTitle          String?
  managerEmployeeId String?
  costCenterId      String?
  // Pay Group linkage arrives with the payroll stage (DATA-MODEL §8).
  payGroupId            String?
  bankAccountReference  String?
  taxIdentifier         String?
  emergencyContact      Json?
  status            String    @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  manager              Employee?                   @relation("EmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  directReports        Employee[]                  @relation("EmployeeManager")
  user                 User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendance           Attendance[]
  leaveRequests        LeaveRequest[]
  payGroup             PayGroup?                   @relation(fields: [payGroupId], references: [id])
  salaryAssignments    EmployeeSalaryAssignment[]
  payrollEntries       PayrollEntry[]

  @@unique([companyId, employeeNo])
  @@index([companyId, employmentStatus])
  @@index([branchId])
}

model Attendance {
  id              String    @id @default(uuid())
  employeeId      String
  companyId       String
  branchId        String?
  attendanceDate  DateTime  @db.Date
  clockIn         DateTime?
  clockOut        DateTime?
  workedMinutes   Int?
  overtimeMinutes Int?
  status          String // PRESENT | ABSENT | LATE | HALF_DAY | LEAVE | HOLIDAY | OFF_DAY
  source          String    @default("MANUAL") // MANUAL | DEVICE | IMPORT
  notes           String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, attendanceDate])
  @@index([companyId, attendanceDate])
}

model LeaveType {
  id                String  @id @default(uuid())
  companyId         String
  code              String
  name              String
  description       String?
  paid              Boolean @default(true)
  requiresAttachment Boolean @default(false)
  requiresApproval  Boolean @default(true)
  annualAllowance   Int?
  carryForward      Boolean @default(false)
  status            String  @default("ACTIVE")

  leaveRequests LeaveRequest[]

  @@unique([companyId, code])
}

model LeaveRequest {
  id                 String    @id @default(uuid())
  employeeId         String
  leaveTypeId        String
  companyId          String
  branchId           String?
  startDate          DateTime  @db.Date
  endDate            DateTime  @db.Date
  requestedDays      Decimal   @db.Decimal(5, 1)
  reason             String?
  status             String    @default("DRAFT") // DRAFT | SUBMITTED | PENDING_APPROVAL | APPROVED | REJECTED | CANCELLED
  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedBy         String?
  rejectedAt         DateTime?
  rejectedBy         String?
  workflowInstanceId String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType  LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([employeeId, startDate])
}

model Holiday {
  id           String   @id @default(uuid())
  companyId    String
  branchId     String?
  name         String
  holidayDate  DateTime @db.Date
  isRecurring  Boolean  @default(false)
  status       String   @default("ACTIVE")

  @@index([companyId, holidayDate])
}

// ---------------------------------------------------------------------------
// Payroll — DATA-MODEL §8 (PRD Stage 4)
// ---------------------------------------------------------------------------

model PayGroup {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  frequency   String // MONTHLY | SEMI_MONTHLY | BI_WEEKLY | WEEKLY
  currencyId  String
  payDayRule  String   @default("LAST_DAY_OF_MONTH") // LAST_DAY_OF_MONTH | FIXED_DAY | NEAREST_WORKING_DAY
  payDayValue Int?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  currency    Currency     @relation(fields: [currencyId], references: [id])
  employees   Employee[]
  payrollRuns PayrollRun[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

model SalaryStructure {
  id         String   @id @default(uuid())
  companyId  String
  name       String
  currencyId String
  status     String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  currency    Currency                   @relation(fields: [currencyId], references: [id])
  components  SalaryComponent[]
  assignments EmployeeSalaryAssignment[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

model SalaryComponent {
  id                String   @id @default(uuid())
  salaryStructureId String
  code              String
  name              String
  type              String // EARNING | DEDUCTION | EMPLOYER_CONTRIBUTION
  calculationMethod String // FLAT | PERCENT_OF_BASE
  value             Decimal? @db.Decimal(18, 4) // FLAT amount
  percentage        Decimal? @db.Decimal(9, 4) // percent of base salary
  accountId         String?
  taxable           Boolean  @default(true)
  status            String   @default("ACTIVE")

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  payrollLines    PayrollLine[]

  @@unique([salaryStructureId, code])
  @@index([salaryStructureId, type])
}

model EmployeeSalaryAssignment {
  id                String    @id @default(uuid())
  employeeId        String
  salaryStructureId String
  effectiveFrom     DateTime  @db.Date
  effectiveTo       DateTime? @db.Date
  baseSalary        Decimal   @db.Decimal(18, 2)
  currencyId        String
  status            String    @default("ACTIVE") // ACTIVE | SUPERSEDED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)
  currency        Currency        @relation(fields: [currencyId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@index([salaryStructureId])
}

model PayrollRun {
  id                 String    @id @default(uuid())
  companyId          String
  branchId           String?
  payGroupId         String
  periodStart        DateTime  @db.Date
  periodEnd          DateTime  @db.Date
  paymentDate        DateTime  @db.Date
  currencyId         String
  status             String    @default("DRAFT") // DRAFT | CALCULATING | CALCULATED | PENDING_APPROVAL | APPROVED | POSTED | PAID | CANCELLED
  employeeCount      Int       @default(0)
  totalGross         Decimal   @default(0) @db.Decimal(18, 2)
  totalDeductions    Decimal   @default(0) @db.Decimal(18, 2)
  totalNet           Decimal   @default(0) @db.Decimal(18, 2)
  totalEmployerCost  Decimal   @default(0) @db.Decimal(18, 2)
  /** Employees skipped during calculation, with reasons (UI-UX §24 Exceptions tab). */
  exceptions         Json?
  workflowInstanceId String?   @unique
  approvedBy         String?
  approvedAt         DateTime?
  postedBy           String?
  postedAt           DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payGroup PayGroup       @relation(fields: [payGroupId], references: [id], onDelete: Restrict)
  currency Currency       @relation(fields: [currencyId], references: [id])
  entries  PayrollEntry[]

  @@index([companyId, status])
  @@index([payGroupId, periodStart, periodEnd])
}

model PayrollEntry {
  id              String   @id @default(uuid())
  payrollRunId    String
  employeeId      String
  grossAmount     Decimal  @default(0) @db.Decimal(18, 2)
  deductionAmount Decimal  @default(0) @db.Decimal(18, 2)
  netAmount       Decimal  @default(0) @db.Decimal(18, 2)
  employerCost    Decimal  @default(0) @db.Decimal(18, 2)
  status          String   @default("CALCULATED") // CALCULATED | APPROVED | POSTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payrollRun PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  lines      PayrollLine[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model PayrollLine {
  id                String   @id @default(uuid())
  payrollEntryId    String
  salaryComponentId String
  description       String
  quantity          Decimal  @default(1) @db.Decimal(18, 4)
  rate              Decimal  @default(0) @db.Decimal(18, 4)
  amount            Decimal  @default(0) @db.Decimal(18, 2)
  taxable           Boolean  @default(true)
  accountId         String?
  createdAt         DateTime @default(now())

  payrollEntry    PayrollEntry    @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)

  @@index([payrollEntryId])
  @@index([salaryComponentId])
}

// ---------------------------------------------------------------------------
// Procurement — DATA-MODEL §9 (PRD Stage 5): procure-to-pay chain.
// ---------------------------------------------------------------------------

model Supplier {
  id                      String   @id @default(uuid())
  companyId               String
  branchId                String?
  supplierNo              String
  legalName               String
  displayName             String
  taxNumber               String?
  registrationNumber      String?
  email                   String?
  phone                   String?
  address                 String?
  currencyId              String
  paymentTermsId          String?
  defaultPayableAccountId String?
  status                  String   @default("ACTIVE") // ACTIVE | ON_HOLD | BLACKLISTED | INACTIVE
  createdById             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  currency       Currency             @relation(fields: [currencyId], references: [id])
  bankAccounts   SupplierBankAccount[]
  quotations     SupplierQuotation[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  invoices       SupplierInvoice[]
  payments       SupplierPayment[]
  requestLines   PurchaseRequestLine[]
  rfqSuppliers   RfqSupplier[]

  @@unique([companyId, supplierNo])
  @@index([companyId, status])
}

model SupplierBankAccount {
  id            String   @id @default(uuid())
  supplierId    String
  bankName      String
  accountName   String
  accountNumber String
  routingRef    String?
  currencyId    String
  isDefault     Boolean  @default(false)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model PurchaseRequest {
  id                 String    @id @default(uuid())
  companyId          String
  branchId           String?
  departmentId       String?
  requestNo          String
  requestedBy        String
  requiredDate       DateTime  @db.Date
  purpose            String?
  status             String    @default("DRAFT") // DRAFT | SUBMITTED | PENDING_APPROVAL | APPROVED | REJECTED | CHANGES_REQUESTED | CANCELLED
  workflowInstanceId String?   @unique
  decidedBy          String?
  decidedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lines PurchaseRequestLine[]
  rfqs  Rfq[]

  @@unique([companyId, requestNo])
  @@index([companyId, status])
}

model PurchaseRequestLine {
  id                  String   @id @default(uuid())
  purchaseRequestId   String
  productId           String?
  description         String
  quantity            Decimal  @db.Decimal(18, 4)
  unitId              String?
  estimatedUnitCost   Decimal  @default(0) @db.Decimal(18, 4)
  estimatedTotal      Decimal  @default(0) @db.Decimal(18, 2)
  preferredSupplierId String?

  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  preferredSupplier Supplier?       @relation(fields: [preferredSupplierId], references: [id])

  @@index([purchaseRequestId])
}

model Rfq {
  id                String   @id @default(uuid())
  companyId         String
  branchId          String?
  rfqNo             String
  purchaseRequestId String?
  issueDate         DateTime @db.Date
  responseDueDate   DateTime @db.Date
  status            String   @default("DRAFT") // DRAFT | SENT | CLOSED | CANCELLED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseRequest PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  suppliers       RfqSupplier[]
  quotations      SupplierQuotation[]

  @@unique([companyId, rfqNo])
  @@index([companyId, status])
}

model RfqSupplier {
  id         String   @id @default(uuid())
  rfqId      String
  supplierId String
  invitedAt  DateTime @default(now())

  rfq      Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([rfqId, supplierId])
}

model SupplierQuotation {
  id            String    @id @default(uuid())
  companyId     String
  branchId      String?
  quotationNo   String
  supplierId    String
  rfqId         String?
  quotationDate DateTime  @db.Date
  validUntil    DateTime? @db.Date
  currencyId    String
  subtotal      Decimal   @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal    Decimal   @default(0) @db.Decimal(18, 2)
  status        String    @default("RECEIVED") // RECEIVED | SELECTED | REJECTED | EXPIRED
  selectedBy    String?
  selectedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  rfq      Rfq?     @relation(fields: [rfqId], references: [id])
  lines    SupplierQuotationLine[]
  orders   PurchaseOrder[]

  @@unique([companyId, quotationNo])
  @@index([rfqId])
}

model SupplierQuotationLine {
  id          String   @id @default(uuid())
  quotationId String
  productId   String?
  description String
  quantity    Decimal  @db.Decimal(18, 4)
  unitId      String?
  unitPrice   Decimal  @db.Decimal(18, 4)
  taxAmount   Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal   Decimal  @default(0) @db.Decimal(18, 2)

  quotation SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model PurchaseOrder {
  id                 String    @id @default(uuid())
  companyId          String
  branchId           String?
  departmentId       String?
  warehouseId        String?
  poNo               String
  supplierId         String
  rfqId              String?
  quotationId        String?
  orderDate          DateTime  @db.Date
  expectedDate       DateTime? @db.Date
  currencyId         String
  paymentTermsId     String?
  subtotal           Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal      Decimal   @default(0) @db.Decimal(18, 2)
  taxTotal           Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal         Decimal   @default(0) @db.Decimal(18, 2)
  status             String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | PARTIALLY_RECEIVED | RECEIVED | CLOSED | CANCELLED
  workflowInstanceId String?   @unique
  decidedBy          String?
  decidedAt          DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  supplier  Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  quotation SupplierQuotation? @relation(fields: [quotationId], references: [id])
  lines     PurchaseOrderLine[]
  receipts  GoodsReceipt[]
  invoices  SupplierInvoice[]

  @@unique([companyId, poNo])
  @@index([companyId, status])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id               String   @id @default(uuid())
  purchaseOrderId  String
  productId        String?
  description      String
  quantity         Decimal  @db.Decimal(18, 4)
  unitId           String?
  unitPrice        Decimal  @db.Decimal(18, 4)
  discount         Decimal  @default(0) @db.Decimal(18, 4)
  taxAmount        Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal        Decimal  @default(0) @db.Decimal(18, 2)
  receivedQuantity Decimal  @default(0) @db.Decimal(18, 4)
  billedQuantity   Decimal  @default(0) @db.Decimal(18, 4)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receiptLines  GoodsReceiptLine[]
  invoiceLines  SupplierInvoiceLine[]

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  companyId       String
  branchId        String?
  warehouseId     String?
  receiptNo       String
  supplierId      String
  purchaseOrderId String
  receiptDate     DateTime @db.Date
  receivedBy      String
  status          String   @default("DRAFT") // DRAFT | POSTED | CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lines         GoodsReceiptLine[]
  invoices      SupplierInvoice[]

  @@unique([companyId, receiptNo])
  @@index([companyId, status])
  @@index([purchaseOrderId])
}

model GoodsReceiptLine {
  id                  String   @id @default(uuid())
  goodsReceiptId      String
  purchaseOrderLineId String
  productId           String?
  warehouseLocationId String?
  quantity            Decimal  @db.Decimal(18, 4)
  unitId              String?
  batchNo             String?
  serialNo            String?
  unitCost            Decimal  @default(0) @db.Decimal(18, 4)

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
}

model SupplierInvoice {
  id                String    @id @default(uuid())
  companyId         String
  branchId          String?
  supplierId        String
  supplierInvoiceNo String
  internalInvoiceNo String
  purchaseOrderId   String?
  goodsReceiptId    String?
  invoiceDate       DateTime  @db.Date
  dueDate           DateTime  @db.Date
  currencyId        String
  subtotal          Decimal   @default(0) @db.Decimal(18, 2)
  taxTotal          Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal        Decimal   @default(0) @db.Decimal(18, 2)
  paidAmount        Decimal   @default(0) @db.Decimal(18, 2)
  matchStatus       String    @default("UNMATCHED") // UNMATCHED | MATCHED | VARIANCE
  matchDetail       Json?
  status            String    @default("DRAFT") // DRAFT | MATCHED | APPROVED | POSTED | PARTIALLY_PAID | PAID | CANCELLED
  postingDate       DateTime?
  journalEntryId    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  supplier      Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  GoodsReceipt?               @relation(fields: [goodsReceiptId], references: [id])
  lines         SupplierInvoiceLine[]
  allocations   SupplierPaymentAllocation[]

  @@unique([companyId, internalInvoiceNo])
  @@unique([companyId, supplierId, supplierInvoiceNo])
  @@index([companyId, status])
}

model SupplierInvoiceLine {
  id                  String   @id @default(uuid())
  supplierInvoiceId   String
  purchaseOrderLineId String?
  goodsReceiptLineId  String?
  productId           String?
  description         String
  quantity            Decimal  @db.Decimal(18, 4)
  unitId              String?
  unitPrice           Decimal  @db.Decimal(18, 4)
  taxAmount           Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal           Decimal  @default(0) @db.Decimal(18, 2)

  invoice           SupplierInvoice    @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])

  @@index([supplierInvoiceId])
}

model SupplierPayment {
  id             String    @id @default(uuid())
  companyId      String
  branchId       String?
  supplierId     String
  paymentNo      String
  paymentDate    DateTime  @db.Date
  currencyId     String
  amount         Decimal   @db.Decimal(18, 2)
  method         String    @default("BANK_TRANSFER") // BANK_TRANSFER | CASH | CHEQUE
  bankAccountRef String?
  reference      String?
  status         String    @default("DRAFT") // DRAFT | POSTED | CANCELLED
  postedBy       String?
  postedAt       DateTime?
  journalEntryId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  supplier    Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  allocations SupplierPaymentAllocation[]

  @@unique([companyId, paymentNo])
  @@index([companyId, status])
  @@index([supplierId])
}

model SupplierPaymentAllocation {
  id                String  @id @default(uuid())
  supplierPaymentId String
  supplierInvoiceId String
  amount            Decimal @db.Decimal(18, 2)

  payment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  invoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)

  @@index([supplierPaymentId])
  @@index([supplierInvoiceId])
}

model AuditLog {
  id           String   @id @default(uuid())
  companyId    String?
  branchId     String?
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  requestId    String?
  timestamp    DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  beforeData   Json?
  afterData    Json?
  metadata     Json?

  @@index([companyId, timestamp])
  @@index([actorUserId, timestamp])
  @@index([resourceType, resourceId])
}

// ---------------------------------------------------------------------------
// Platform — Search (DATA-MODEL §23)
// ---------------------------------------------------------------------------

model SearchDocument {
  id         String   @id @default(uuid())
  companyId  String
  branchId   String?
  entityType String
  entityId   String
  title      String
  subtitle   String?
  searchText String
  metadata   Json?
  updatedAt  DateTime @updatedAt

  @@unique([companyId, entityType, entityId])
  @@index([companyId, entityType])
}

// ---------------------------------------------------------------------------
// Health probe tracking for readiness (ARCHITECTURE §56)
// ---------------------------------------------------------------------------

model SystemHealthEvent {
  id        String   @id @default(uuid())
  component String // postgres | redis | object-storage | worker
  status    String // UP | DOWN
  detail    String?
  checkedAt DateTime @default(now())

  @@index([component, checkedAt])
}

// ---------------------------------------------------------------------------
// Platform — Settings (PRD Stage 2: Core Platform — Settings)
// ---------------------------------------------------------------------------

model SystemSetting {
  id         String   @id @default(uuid())
  key        String
  value      Json
  valueType  String   @default("string") // string | number | boolean | json
  companyId  String?
  description String?
  updatedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, key])
}
