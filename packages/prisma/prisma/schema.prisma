// Enterprise Office ERP — Prisma schema (Stage 1: Foundation + Core Platform)
// Source: DATA-MODEL.md (sections 3–8, 17–23), ARCHITECTURE.md §16.
// Conventions: UUID PKs, timestamps, created_by/updated_by, organization scoping,
// exact decimals for money, explicit relations and indexes.
// Later stages (HR, Payroll, Procurement, Inventory, Sales, Accounting) extend
// this schema with their own vertical-slice migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform — Organization (DATA-MODEL §4)
// ---------------------------------------------------------------------------

model Company {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  legalName          String?
  registrationNumber String?
  taxNumber          String?
  timezone           String   @default("UTC")
  address            String?
  phone              String?
  email              String?
  website            String?
  baseCurrencyId     String?
  fiscalYearStart    Int      @default(1) // month number 1-12
  status             String   @default("ACTIVE")
  settings           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String?
  updatedById        String?

  branches          Branch[]
  departments       Department[]
  costCenters       CostCenter[]
  warehouses        Warehouse[]
  financialPeriods  FinancialPeriod[]
  accounts          Account[]
  unitOfMeasures    UnitOfMeasure[]
  productCategories ProductCategory[]
  products          Product[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  stockTransfers    StockTransfer[]
  stockAdjustments  StockAdjustment[]
  customers         Customer[]
  salesQuotations   SalesQuotation[]
  salesOrders       SalesOrder[]
  deliveries        Delivery[]
  customerInvoices  CustomerInvoice[]
  customerReceipts  CustomerReceipt[]
  journalEntries    JournalEntry[]
  visitors          Visitor[]
  callLogs          CallLog[]
  correspondences   Correspondence[]
  fileRecords       FileRecord[]
  conversations     Conversation[]

  @@index([status])
}

model Branch {
  id                String   @id @default(uuid())
  companyId         String
  code              String
  name              String
  type              String?
  timezone          String   @default("UTC")
  address           String?
  phone             String?
  email             String?
  managerEmployeeId String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?
  updatedById       String?

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  departments Department[]
  warehouses  Warehouse[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model Department {
  id                String   @id @default(uuid())
  companyId         String
  branchId          String
  parentId          String?  @map("parent_department_id")
  code              String
  name              String
  managerEmployeeId String?
  costCenterId      String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?
  updatedById       String?

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentTree")

  @@unique([companyId, code])
  @@index([companyId, branchId, status])
}

model CostCenter {
  id                String   @id @default(uuid())
  companyId         String
  branchId          String?
  code              String
  name              String
  description       String?
  managerEmployeeId String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([companyId, status])
}

model Warehouse {
  id                String   @id @default(uuid())
  companyId         String
  branchId          String
  code              String
  name              String
  type              String?
  address           String?
  managerEmployeeId String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?
  updatedById       String?

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  locations     WarehouseLocation[]
  stockBalances StockBalance[]
  movements     StockMovement[]
  transfersFrom StockTransfer[]     @relation("TransfersFrom")
  transfersTo   StockTransfer[]     @relation("TransfersTo")
  adjustments   StockAdjustment[]
  salesOrders   SalesOrder[]
  deliveries    Delivery[]

  @@unique([companyId, code])
  @@index([companyId, branchId, status])
}

model WarehouseLocation {
  id           String   @id @default(uuid())
  warehouseId  String
  code         String
  name         String
  parentId     String?  @map("parent_location_id")
  locationType String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  parent        WarehouseLocation?  @relation("LocationTree", fields: [parentId], references: [id])
  children      WarehouseLocation[] @relation("LocationTree")
  stockBalances StockBalance[]
  movements     StockMovement[]
  deliveryLines DeliveryLine[]

  @@unique([warehouseId, code])
}

// ---------------------------------------------------------------------------
// Platform — Currency (DATA-MODEL §16)
// ---------------------------------------------------------------------------

model Currency {
  id            String @id @default(uuid())
  code          String @unique
  name          String
  symbol        String
  decimalPlaces Int    @default(2)
  status        String @default("ACTIVE")

  payGroups         PayGroup[]
  salaryStructures  SalaryStructure[]
  salaryAssignments EmployeeSalaryAssignment[]
  payrollRuns       PayrollRun[]
  suppliers         Supplier[]
  customers         Customer[]
  salesQuotations   SalesQuotation[]
  salesOrders       SalesOrder[]
  deliveries        Delivery[]
  customerInvoices  CustomerInvoice[]
  customerReceipts  CustomerReceipt[]
}

// ---------------------------------------------------------------------------
// Platform — Identity & Authorization (DATA-MODEL §5)
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  displayName         String
  phone               String?
  employeeId          String?   @unique @map("employee_id")
  passwordHash        String
  status              String    @default("ACTIVE") // ACTIVE | DISABLED | LOCKED
  mfaEnabled          Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String?
  updatedById         String?

  roles         UserRoleAssignment[]
  refreshTokens RefreshToken[]
  sessions      UserSession[]
  preferences   NotificationPreference[]
  employee      Employee?

  @@index([status])
}

model Role {
  id           String  @id @default(uuid())
  name         String
  code         String  @unique
  description  String?
  isSystemRole Boolean @default(false) @map("is_system_role")
  status       String  @default("ACTIVE")

  permissions RolePermission[]
  users       UserRoleAssignment[]
}

model Permission {
  id       String @id @default(uuid())
  module   String
  resource String
  action   String

  roles RolePermission[]

  @@unique([module, resource, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  id           String    @id @default(uuid())
  userId       String
  roleId       String
  companyId    String?
  branchId     String?
  departmentId String?
  warehouseId  String?
  validFrom    DateTime  @default(now())
  validTo      DateTime?
  createdAt    DateTime  @default(now())
  createdById  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roleId])
}

model UserSession {
  id             String    @id @default(uuid())
  userId         String
  refreshTokenId String?
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  family       String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, family])
}

// ---------------------------------------------------------------------------
// Platform — Financial Periods & Chart of Accounts (foundation seed needs these)
// (DATA-MODEL §12, §13)
// ---------------------------------------------------------------------------

model FinancialPeriod {
  id         String    @id @default(uuid())
  companyId  String
  fiscalYear Int
  periodNo   Int
  startDate  DateTime  @map("start_date")
  endDate    DateTime  @map("end_date")
  status     String    @default("OPEN") // OPEN | CLOSING | CLOSED
  closedById String?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]

  @@unique([companyId, fiscalYear, periodNo])
  @@index([companyId, status])
}

model Account {
  id               String   @id @default(uuid())
  companyId        String
  parentId         String?
  accountCode      String
  accountName      String
  accountType      String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  normalBalance    String // DEBIT | CREDIT
  currencyId       String?
  isControlAccount Boolean  @default(false) @map("is_control_account")
  isPostable       Boolean  @default(true) @map("is_postable")
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent       Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountTree")
  journalLines JournalLine[]

  @@unique([companyId, accountCode])
  @@index([companyId, accountType])
}

// ---------------------------------------------------------------------------
// Platform — Numbering (DATA-MODEL §3, ARCHITECTURE §41)
// ---------------------------------------------------------------------------

model DocumentSequence {
  id           String @id @default(uuid())
  companyId    String
  documentType String
  fiscalYear   Int
  prefix       String
  nextNumber   BigInt @default(1)

  @@unique([companyId, documentType, fiscalYear])
}

// ---------------------------------------------------------------------------
// Platform — Workflow & Approvals (DATA-MODEL §17)
// ---------------------------------------------------------------------------

model WorkflowDefinition {
  id         String  @id @default(uuid())
  companyId  String?
  name       String
  entityType String
  version    Int     @default(1)
  status     String  @default("ACTIVE")

  states      WorkflowState[]
  transitions WorkflowTransition[]
  instances   WorkflowInstance[]

  @@unique([companyId, entityType, version])
}

model WorkflowState {
  id           String  @id @default(uuid())
  definitionId String
  code         String
  name         String
  isInitial    Boolean @default(false) @map("is_initial")
  isTerminal   Boolean @default(false) @map("is_terminal")

  definition      WorkflowDefinition   @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  transitionsFrom WorkflowTransition[] @relation("TransitionFrom")
  transitionsTo   WorkflowTransition[] @relation("TransitionTo")

  @@unique([definitionId, code])
}

model WorkflowTransition {
  id           String @id @default(uuid())
  definitionId String
  fromStateId  String
  toStateId    String
  action       String
  condition    Json?

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  fromState  WorkflowState      @relation("TransitionFrom", fields: [fromStateId], references: [id], onDelete: Restrict)
  toState    WorkflowState      @relation("TransitionTo", fields: [toStateId], references: [id], onDelete: Restrict)

  @@unique([definitionId, fromStateId, action])
}

model WorkflowInstance {
  id           String    @id @default(uuid())
  definitionId String
  entityType   String
  entityId     String
  currentState String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  tasks      ApprovalTask[]

  @@unique([entityType, entityId, definitionId])
  @@index([entityType, entityId])
  @@index([currentState])
}

model ApprovalTask {
  id              String    @id @default(uuid())
  instanceId      String
  step            Int       @default(1)
  approverType    String // USER | ROLE
  approverId      String
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | CHANGES_REQUESTED | CANCELLED
  dueAt           DateTime?
  actedAt         DateTime?
  actedBy         String?
  comments        String?
  rejectionReason String?
  delegatedFrom   String?
  createdAt       DateTime  @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([approverType, approverId, status])
  @@index([status, dueAt])
}

// ---------------------------------------------------------------------------
// Platform — Documents (DATA-MODEL §18)
// ---------------------------------------------------------------------------

model Document {
  id           String   @id @default(uuid())
  companyId    String
  branchId     String?
  documentType String?
  title        String
  description  String?
  storageKey   String
  filename     String
  mimeType     String
  sizeBytes    BigInt
  contentHash  String?
  version      Int      @default(1)
  accessPolicy String   @default("COMPANY") // COMPANY | BRANCH | PRIVATE
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  links    DocumentLink[]
  versions DocumentVersion[]

  @@index([companyId, documentType])
  @@index([createdById])
}

model DocumentLink {
  id               String @id @default(uuid())
  documentId       String
  entityType       String
  entityId         String
  relationshipType String @default("ATTACHMENT")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityType, entityId, relationshipType])
  @@index([entityType, entityId])
}

model DocumentVersion {
  id           String   @id @default(uuid())
  documentId   String
  versionNo    Int
  storageKey   String
  contentHash  String?
  sizeBytes    BigInt
  uploadedById String
  uploadedAt   DateTime @default(now())
  changeReason String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo])
}

// ---------------------------------------------------------------------------
// Platform — Notifications (DATA-MODEL §20)
// ---------------------------------------------------------------------------

model Notification {
  id           String    @id @default(uuid())
  userId       String
  companyId    String?
  type         String
  title        String
  message      String
  resourceType String?
  resourceId   String?
  channel      String    @default("IN_APP")
  status       String    @default("UNREAD") // UNREAD | READ | FAILED
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@index([userId, status])
  @@index([companyId, type])
}

model NotificationDelivery {
  id                String    @id @default(uuid())
  notificationId    String
  provider          String
  attempt           Int       @default(1)
  status            String    @default("PENDING") // PENDING | SENT | FAILED
  providerReference String?
  errorCode         String?
  sentAt            DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
}

model NotificationPreference {
  id        String  @id @default(uuid())
  userId    String
  eventType String
  channel   String
  enabled   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
}

// ---------------------------------------------------------------------------
// Platform — Events / Outbox (DATA-MODEL §21)
// ---------------------------------------------------------------------------

model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  status        String    @default("PENDING") // PENDING | PUBLISHED | FAILED
  lastError     String?

  @@index([status, occurredAt])
}

// ---------------------------------------------------------------------------
// HR — Employees, Attendance, Leave, Holidays (DATA-MODEL §6, §7)
// ---------------------------------------------------------------------------

model Employee {
  id                   String    @id @default(uuid())
  companyId            String
  branchId             String?
  departmentId         String?
  employeeNo           String
  userId               String?   @unique
  firstName            String
  middleName           String?
  lastName             String
  displayName          String
  gender               String?
  dateOfBirth          DateTime? @db.Date
  nationality          String?
  nationalId           String?
  email                String?
  phone                String?
  address              String?
  hireDate             DateTime  @db.Date
  terminationDate      DateTime? @db.Date
  employmentStatus     String    @default("DRAFT") // DRAFT | ACTIVE | ON_LEAVE | SUSPENDED | TERMINATED | RETIRED
  employmentType       String? // FULL_TIME | PART_TIME | CONTRACT | INTERN
  jobTitle             String?
  managerEmployeeId    String?
  costCenterId         String?
  // Pay Group linkage arrives with the payroll stage (DATA-MODEL §8).
  payGroupId           String?
  bankAccountReference String?
  taxIdentifier        String?
  emergencyContact     Json?
  status               String    @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  manager           Employee?                  @relation("EmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  directReports     Employee[]                 @relation("EmployeeManager")
  user              User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendance        Attendance[]
  leaveRequests     LeaveRequest[]
  payGroup          PayGroup?                  @relation(fields: [payGroupId], references: [id])
  salaryAssignments EmployeeSalaryAssignment[]
  payrollEntries    PayrollEntry[]

  @@unique([companyId, employeeNo])
  @@index([companyId, employmentStatus])
  @@index([branchId])
  @@index([payGroupId])
}

model Attendance {
  id              String    @id @default(uuid())
  employeeId      String
  companyId       String
  branchId        String?
  attendanceDate  DateTime  @db.Date
  clockIn         DateTime?
  clockOut        DateTime?
  workedMinutes   Int?
  overtimeMinutes Int?
  status          String // PRESENT | ABSENT | LATE | HALF_DAY | LEAVE | HOLIDAY | OFF_DAY
  source          String    @default("MANUAL") // MANUAL | DEVICE | IMPORT
  notes           String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, attendanceDate])
  @@index([companyId, attendanceDate])
}

model LeaveType {
  id                 String  @id @default(uuid())
  companyId          String
  code               String
  name               String
  description        String?
  paid               Boolean @default(true)
  requiresAttachment Boolean @default(false)
  requiresApproval   Boolean @default(true)
  annualAllowance    Int?
  carryForward       Boolean @default(false)
  status             String  @default("ACTIVE")

  leaveRequests LeaveRequest[]

  @@unique([companyId, code])
}

model LeaveRequest {
  id                 String    @id @default(uuid())
  employeeId         String
  leaveTypeId        String
  companyId          String
  branchId           String?
  startDate          DateTime  @db.Date
  endDate            DateTime  @db.Date
  requestedDays      Decimal   @db.Decimal(5, 1)
  reason             String?
  status             String    @default("DRAFT") // DRAFT | SUBMITTED | PENDING_APPROVAL | APPROVED | REJECTED | CANCELLED
  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedBy         String?
  rejectedAt         DateTime?
  rejectedBy         String?
  workflowInstanceId String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([employeeId, startDate])
}

model Holiday {
  id          String   @id @default(uuid())
  companyId   String
  branchId    String?
  name        String
  holidayDate DateTime @db.Date
  isRecurring Boolean  @default(false)
  status      String   @default("ACTIVE")

  @@index([companyId, holidayDate])
}

// ---------------------------------------------------------------------------
// Payroll — DATA-MODEL §8 (PRD Stage 4)
// ---------------------------------------------------------------------------

model PayGroup {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  frequency   String // MONTHLY | SEMI_MONTHLY | BI_WEEKLY | WEEKLY
  currencyId  String
  payDayRule  String   @default("LAST_DAY_OF_MONTH") // LAST_DAY_OF_MONTH | FIXED_DAY | NEAREST_WORKING_DAY
  payDayValue Int?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  currency    Currency     @relation(fields: [currencyId], references: [id])
  employees   Employee[]
  payrollRuns PayrollRun[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

model SalaryStructure {
  id         String   @id @default(uuid())
  companyId  String
  name       String
  currencyId String
  status     String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  currency    Currency                   @relation(fields: [currencyId], references: [id])
  components  SalaryComponent[]
  assignments EmployeeSalaryAssignment[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

model SalaryComponent {
  id                String   @id @default(uuid())
  salaryStructureId String
  code              String
  name              String
  type              String // EARNING | DEDUCTION | EMPLOYER_CONTRIBUTION
  calculationMethod String // FLAT | PERCENT_OF_BASE
  value             Decimal? @db.Decimal(18, 4) // FLAT amount
  percentage        Decimal? @db.Decimal(9, 4) // percent of base salary
  accountId         String?
  taxable           Boolean  @default(true)
  status            String   @default("ACTIVE")

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  payrollLines    PayrollLine[]

  @@unique([salaryStructureId, code])
  @@index([salaryStructureId, type])
}

model EmployeeSalaryAssignment {
  id                String    @id @default(uuid())
  employeeId        String
  salaryStructureId String
  effectiveFrom     DateTime  @db.Date
  effectiveTo       DateTime? @db.Date
  baseSalary        Decimal   @db.Decimal(18, 2)
  currencyId        String
  status            String    @default("ACTIVE") // ACTIVE | SUPERSEDED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)
  currency        Currency        @relation(fields: [currencyId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@index([salaryStructureId])
}

model PayrollRun {
  id                 String    @id @default(uuid())
  companyId          String
  branchId           String?
  payGroupId         String
  periodStart        DateTime  @db.Date
  periodEnd          DateTime  @db.Date
  paymentDate        DateTime  @db.Date
  currencyId         String
  status             String    @default("DRAFT") // DRAFT | CALCULATING | CALCULATED | PENDING_APPROVAL | APPROVED | POSTED | PAID | CANCELLED
  employeeCount      Int       @default(0)
  totalGross         Decimal   @default(0) @db.Decimal(18, 2)
  totalDeductions    Decimal   @default(0) @db.Decimal(18, 2)
  totalNet           Decimal   @default(0) @db.Decimal(18, 2)
  totalEmployerCost  Decimal   @default(0) @db.Decimal(18, 2)
  /**
   * Employees skipped during calculation, with reasons (UI-UX §24 Exceptions tab).
   */
  exceptions         Json?
  workflowInstanceId String?   @unique
  approvedBy         String?
  approvedAt         DateTime?
  postedBy           String?
  postedAt           DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payGroup PayGroup       @relation(fields: [payGroupId], references: [id], onDelete: Restrict)
  currency Currency       @relation(fields: [currencyId], references: [id])
  entries  PayrollEntry[]

  @@index([companyId, status])
  @@index([payGroupId, periodStart, periodEnd])
}

model PayrollEntry {
  id              String   @id @default(uuid())
  payrollRunId    String
  employeeId      String
  grossAmount     Decimal  @default(0) @db.Decimal(18, 2)
  deductionAmount Decimal  @default(0) @db.Decimal(18, 2)
  netAmount       Decimal  @default(0) @db.Decimal(18, 2)
  employerCost    Decimal  @default(0) @db.Decimal(18, 2)
  status          String   @default("CALCULATED") // CALCULATED | APPROVED | POSTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payrollRun PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  lines      PayrollLine[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model PayrollLine {
  id                String   @id @default(uuid())
  payrollEntryId    String
  salaryComponentId String
  description       String
  quantity          Decimal  @default(1) @db.Decimal(18, 4)
  rate              Decimal  @default(0) @db.Decimal(18, 4)
  amount            Decimal  @default(0) @db.Decimal(18, 2)
  taxable           Boolean  @default(true)
  accountId         String?
  createdAt         DateTime @default(now())

  payrollEntry    PayrollEntry    @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)

  @@index([payrollEntryId])
  @@index([salaryComponentId])
}

// ---------------------------------------------------------------------------
// Procurement — DATA-MODEL §9 (PRD Stage 5): procure-to-pay chain.
// ---------------------------------------------------------------------------

model Supplier {
  id                      String   @id @default(uuid())
  companyId               String
  branchId                String?
  supplierNo              String
  legalName               String
  displayName             String
  taxNumber               String?
  registrationNumber      String?
  email                   String?
  phone                   String?
  address                 String?
  currencyId              String
  paymentTermsId          String?
  defaultPayableAccountId String?
  status                  String   @default("ACTIVE") // ACTIVE | ON_HOLD | BLACKLISTED | INACTIVE
  createdById             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  currency       Currency              @relation(fields: [currencyId], references: [id])
  bankAccounts   SupplierBankAccount[]
  quotations     SupplierQuotation[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  invoices       SupplierInvoice[]
  payments       SupplierPayment[]
  requestLines   PurchaseRequestLine[]
  rfqSuppliers   RfqSupplier[]

  @@unique([companyId, supplierNo])
  @@index([companyId, status])
}

model SupplierBankAccount {
  id            String   @id @default(uuid())
  supplierId    String
  bankName      String
  accountName   String
  accountNumber String
  routingRef    String?
  currencyId    String
  isDefault     Boolean  @default(false)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model PurchaseRequest {
  id                 String    @id @default(uuid())
  companyId          String
  branchId           String?
  departmentId       String?
  requestNo          String
  requestedBy        String
  requiredDate       DateTime  @db.Date
  purpose            String?
  status             String    @default("DRAFT") // DRAFT | SUBMITTED | PENDING_APPROVAL | APPROVED | REJECTED | CHANGES_REQUESTED | CANCELLED
  workflowInstanceId String?   @unique
  decidedBy          String?
  decidedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lines PurchaseRequestLine[]
  rfqs  Rfq[]

  @@unique([companyId, requestNo])
  @@index([companyId, status])
}

model PurchaseRequestLine {
  id                  String  @id @default(uuid())
  purchaseRequestId   String
  productId           String?
  description         String
  quantity            Decimal @db.Decimal(18, 4)
  unitId              String?
  estimatedUnitCost   Decimal @default(0) @db.Decimal(18, 4)
  estimatedTotal      Decimal @default(0) @db.Decimal(18, 2)
  preferredSupplierId String?

  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  preferredSupplier Supplier?       @relation(fields: [preferredSupplierId], references: [id])

  @@index([purchaseRequestId])
}

model Rfq {
  id                String   @id @default(uuid())
  companyId         String
  branchId          String?
  rfqNo             String
  purchaseRequestId String?
  issueDate         DateTime @db.Date
  responseDueDate   DateTime @db.Date
  status            String   @default("DRAFT") // DRAFT | SENT | CLOSED | CANCELLED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseRequest PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  suppliers       RfqSupplier[]
  quotations      SupplierQuotation[]

  @@unique([companyId, rfqNo])
  @@index([companyId, status])
}

model RfqSupplier {
  id         String   @id @default(uuid())
  rfqId      String
  supplierId String
  invitedAt  DateTime @default(now())

  rfq      Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([rfqId, supplierId])
}

model SupplierQuotation {
  id            String    @id @default(uuid())
  companyId     String
  branchId      String?
  quotationNo   String
  supplierId    String
  rfqId         String?
  quotationDate DateTime  @db.Date
  validUntil    DateTime? @db.Date
  currencyId    String
  subtotal      Decimal   @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal    Decimal   @default(0) @db.Decimal(18, 2)
  status        String    @default("RECEIVED") // RECEIVED | SELECTED | REJECTED | EXPIRED
  selectedBy    String?
  selectedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  supplier Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  rfq      Rfq?                    @relation(fields: [rfqId], references: [id])
  lines    SupplierQuotationLine[]
  orders   PurchaseOrder[]

  @@unique([companyId, quotationNo])
  @@index([rfqId])
}

model SupplierQuotationLine {
  id          String  @id @default(uuid())
  quotationId String
  productId   String?
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitId      String?
  unitPrice   Decimal @db.Decimal(18, 4)
  taxAmount   Decimal @default(0) @db.Decimal(18, 2)
  lineTotal   Decimal @default(0) @db.Decimal(18, 2)

  quotation SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model PurchaseOrder {
  id                 String    @id @default(uuid())
  companyId          String
  branchId           String?
  departmentId       String?
  warehouseId        String?
  poNo               String
  supplierId         String
  rfqId              String?
  quotationId        String?
  orderDate          DateTime  @db.Date
  expectedDate       DateTime? @db.Date
  currencyId         String
  paymentTermsId     String?
  subtotal           Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal      Decimal   @default(0) @db.Decimal(18, 2)
  taxTotal           Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal         Decimal   @default(0) @db.Decimal(18, 2)
  status             String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | PARTIALLY_RECEIVED | RECEIVED | CLOSED | CANCELLED
  workflowInstanceId String?   @unique
  decidedBy          String?
  decidedAt          DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  quotation SupplierQuotation?  @relation(fields: [quotationId], references: [id])
  lines     PurchaseOrderLine[]
  receipts  GoodsReceipt[]
  invoices  SupplierInvoice[]

  @@unique([companyId, poNo])
  @@index([companyId, status])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id               String  @id @default(uuid())
  purchaseOrderId  String
  productId        String?
  description      String
  quantity         Decimal @db.Decimal(18, 4)
  unitId           String?
  unitPrice        Decimal @db.Decimal(18, 4)
  discount         Decimal @default(0) @db.Decimal(18, 4)
  taxAmount        Decimal @default(0) @db.Decimal(18, 2)
  lineTotal        Decimal @default(0) @db.Decimal(18, 2)
  receivedQuantity Decimal @default(0) @db.Decimal(18, 4)
  billedQuantity   Decimal @default(0) @db.Decimal(18, 4)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receiptLines  GoodsReceiptLine[]
  invoiceLines  SupplierInvoiceLine[]

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  companyId       String
  branchId        String?
  warehouseId     String?
  receiptNo       String
  supplierId      String
  purchaseOrderId String
  receiptDate     DateTime @db.Date
  receivedBy      String
  status          String   @default("DRAFT") // DRAFT | POSTED | CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lines         GoodsReceiptLine[]
  invoices      SupplierInvoice[]

  @@unique([companyId, receiptNo])
  @@index([companyId, status])
  @@index([purchaseOrderId])
}

model GoodsReceiptLine {
  id                  String  @id @default(uuid())
  goodsReceiptId      String
  purchaseOrderLineId String
  productId           String?
  warehouseLocationId String?
  quantity            Decimal @db.Decimal(18, 4)
  unitId              String?
  batchNo             String?
  serialNo            String?
  unitCost            Decimal @default(0) @db.Decimal(18, 4)

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
}

model SupplierInvoice {
  id                String    @id @default(uuid())
  companyId         String
  branchId          String?
  supplierId        String
  supplierInvoiceNo String
  internalInvoiceNo String
  purchaseOrderId   String?
  goodsReceiptId    String?
  invoiceDate       DateTime  @db.Date
  dueDate           DateTime  @db.Date
  currencyId        String
  subtotal          Decimal   @default(0) @db.Decimal(18, 2)
  taxTotal          Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal        Decimal   @default(0) @db.Decimal(18, 2)
  paidAmount        Decimal   @default(0) @db.Decimal(18, 2)
  matchStatus       String    @default("UNMATCHED") // UNMATCHED | MATCHED | VARIANCE
  matchDetail       Json?
  status            String    @default("DRAFT") // DRAFT | MATCHED | APPROVED | POSTED | PARTIALLY_PAID | PAID | CANCELLED
  postingDate       DateTime?
  journalEntryId    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  supplier      Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  GoodsReceipt?               @relation(fields: [goodsReceiptId], references: [id])
  lines         SupplierInvoiceLine[]
  allocations   SupplierPaymentAllocation[]

  @@unique([companyId, internalInvoiceNo])
  @@unique([companyId, supplierId, supplierInvoiceNo])
  @@index([companyId, status])
}

model SupplierInvoiceLine {
  id                  String  @id @default(uuid())
  supplierInvoiceId   String
  purchaseOrderLineId String?
  goodsReceiptLineId  String?
  productId           String?
  description         String
  quantity            Decimal @db.Decimal(18, 4)
  unitId              String?
  unitPrice           Decimal @db.Decimal(18, 4)
  taxAmount           Decimal @default(0) @db.Decimal(18, 2)
  lineTotal           Decimal @default(0) @db.Decimal(18, 2)

  invoice           SupplierInvoice    @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])

  @@index([supplierInvoiceId])
}

model SupplierPayment {
  id             String    @id @default(uuid())
  companyId      String
  branchId       String?
  supplierId     String
  paymentNo      String
  paymentDate    DateTime  @db.Date
  currencyId     String
  amount         Decimal   @db.Decimal(18, 2)
  method         String    @default("BANK_TRANSFER") // BANK_TRANSFER | CASH | CHEQUE
  bankAccountRef String?
  reference      String?
  status         String    @default("DRAFT") // DRAFT | POSTED | CANCELLED
  postedBy       String?
  postedAt       DateTime?
  journalEntryId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  supplier    Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  allocations SupplierPaymentAllocation[]

  @@unique([companyId, paymentNo])
  @@index([companyId, status])
  @@index([supplierId])
}

model SupplierPaymentAllocation {
  id                String  @id @default(uuid())
  supplierPaymentId String
  supplierInvoiceId String
  amount            Decimal @db.Decimal(18, 2)

  payment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  invoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)

  @@index([supplierPaymentId])
  @@index([supplierInvoiceId])
}

model AuditLog {
  id           String   @id @default(uuid())
  companyId    String?
  branchId     String?
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  requestId    String?
  timestamp    DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  beforeData   Json?
  afterData    Json?
  metadata     Json?

  @@index([companyId, timestamp])
  @@index([actorUserId, timestamp])
  @@index([resourceType, resourceId])
}

// ---------------------------------------------------------------------------
// Platform — Search (DATA-MODEL §23)
// ---------------------------------------------------------------------------

model SearchDocument {
  id         String   @id @default(uuid())
  companyId  String
  branchId   String?
  entityType String
  entityId   String
  title      String
  subtitle   String?
  searchText String
  metadata   Json?
  updatedAt  DateTime @updatedAt

  @@unique([companyId, entityType, entityId])
  @@index([companyId, entityType])
}

// ---------------------------------------------------------------------------
// Health probe tracking for readiness (ARCHITECTURE §56)
// ---------------------------------------------------------------------------

model SystemHealthEvent {
  id        String   @id @default(uuid())
  component String // postgres | redis | object-storage | worker
  status    String // UP | DOWN
  detail    String?
  checkedAt DateTime @default(now())

  @@index([component, checkedAt])
}

// ---------------------------------------------------------------------------
// Platform — Settings (PRD Stage 2: Core Platform — Settings)
// ---------------------------------------------------------------------------

model SystemSetting {
  id          String   @id @default(uuid())
  key         String
  value       Json
  valueType   String   @default("string") // string | number | boolean | json
  companyId   String?
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, key])
}

// ---------------------------------------------------------------------------
// Inventory (DATA-MODEL §10, CLAUDE.md §16) — Stage 6
// All stock changes flow through StockMovement (the authoritative ledger);
// StockBalance is a derived, maintained projection.
// ---------------------------------------------------------------------------

model UnitOfMeasure {
  id        String   @id @default(uuid())
  companyId String?
  code      String
  name      String
  symbol    String
  precision Int      @default(2)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products Product[] @relation("ProductBaseUnit")

  @@unique([companyId, code])
}

model ProductCategory {
  id               String   @id @default(uuid())
  companyId        String
  parentCategoryId String?
  code             String
  name             String
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentCategoryId], references: [id])
  child    ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, code])
}

model Product {
  id            String   @id @default(uuid())
  companyId     String
  sku           String
  barcode       String?
  name          String
  description   String?
  categoryId    String?
  productType   String   @default("STOCK") // STOCK | SERVICE | NON_STOCK | ASSET
  baseUnitId    String?
  trackBatch    Boolean  @default(false)
  trackSerial   Boolean  @default(false)
  inventoryItem Boolean  @default(true)
  saleable      Boolean  @default(true)
  purchasable   Boolean  @default(true)
  standardCost  Decimal  @default(0) @db.Decimal(18, 4)
  reorderLevel  Decimal  @default(0) @db.Decimal(18, 4)
  reorderQty    Decimal  @default(0) @db.Decimal(18, 4)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  updatedById   String?

  company         Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category        ProductCategory?      @relation(fields: [categoryId], references: [id])
  baseUnit        UnitOfMeasure?        @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])
  stockBalances   StockBalance[]
  movements       StockMovement[]
  transferLines   StockTransferLine[]
  adjustmentLines StockAdjustmentLine[]
  quotationLines  SalesQuotationLine[]  @relation("QuotationLines")
  salesOrderLines SalesOrderLine[]      @relation("OrderLines")
  deliveryLines   DeliveryLine[]        @relation("DeliveryLines")
  invoiceLines    CustomerInvoiceLine[] @relation("InvoiceLines")
  journalLines    JournalLine[]         @relation("JournalLines")

  @@unique([companyId, sku])
  @@index([companyId, status])
  @@index([companyId, categoryId])
}

model StockBalance {
  id                  String   @id @default(uuid())
  companyId           String
  warehouseId         String
  warehouseLocationId String?
  productId           String
  onHand              Decimal  @default(0) @db.Decimal(18, 4)
  reserved            Decimal  @default(0) @db.Decimal(18, 4)
  avgCost             Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt           DateTime @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location  WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])
  product   Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, warehouseLocationId, productId])
  @@index([companyId, productId])
}

model StockMovement {
  id                  String   @id @default(uuid())
  companyId           String
  branchId            String?
  warehouseId         String
  warehouseLocationId String?
  productId           String
  movementType        String // RECEIPT | ISSUE | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT_IN | ADJUSTMENT_OUT | RETURN_IN | RETURN_OUT
  quantity            Decimal  @db.Decimal(18, 4)
  unitCost            Decimal  @default(0) @db.Decimal(18, 4)
  totalCost           Decimal  @default(0) @db.Decimal(18, 4)
  batchNo             String?
  serialNo            String?
  referenceType       String?
  referenceId         String?
  referenceNo         String?
  movementDate        DateTime @default(now())
  postedAt            DateTime @default(now())
  createdById         String?

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location  WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])
  product   Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([companyId, productId, movementDate])
  @@index([companyId, warehouseId])
  @@index([referenceType, referenceId])
}

model StockTransfer {
  id              String   @id @default(uuid())
  companyId       String
  fromWarehouseId String
  toWarehouseId   String
  transferNo      String
  transferDate    DateTime @default(now())
  reason          String?
  status          String   @default("DRAFT") // DRAFT | IN_TRANSIT | COMPLETED | CANCELLED
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fromWarehouse Warehouse           @relation("TransfersFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse           @relation("TransfersTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  lines         StockTransferLine[]

  @@unique([companyId, transferNo])
}

model StockTransferLine {
  id              String  @id @default(uuid())
  stockTransferId String
  productId       String
  quantity        Decimal @db.Decimal(18, 4)
  unitId          String?

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model StockAdjustment {
  id                 String   @id @default(uuid())
  companyId          String
  branchId           String?
  warehouseId        String
  adjustmentNo       String
  reason             String
  status             String   @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | POSTED | CANCELLED
  workflowInstanceId String?
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company   Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     StockAdjustmentLine[]

  @@unique([companyId, adjustmentNo])
}

model StockAdjustmentLine {
  id                 String  @id @default(uuid())
  stockAdjustmentId  String
  productId          String
  systemQuantity     Decimal @db.Decimal(18, 4)
  countedQuantity    Decimal @db.Decimal(18, 4)
  differenceQuantity Decimal @db.Decimal(18, 4)
  unitCost           Decimal @default(0) @db.Decimal(18, 4)
  adjustmentValue    Decimal @default(0) @db.Decimal(18, 4)

  stockAdjustment StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
}

// ---------------------------------------------------------------------------
// Sales (DATA-MODEL §11) — quote to cash
// ---------------------------------------------------------------------------

model Customer {
  id                  String   @id @default(uuid())
  companyId           String
  branchId            String?
  customerNo          String
  legalName           String
  displayName         String
  taxNumber           String?
  email               String?
  phone               String?
  address             String?
  currencyId          String
  paymentTermsId      String?
  creditLimit         Decimal  @default(0) @db.Decimal(18, 2)
  receivableAccountId String?
  status              String   @default("ACTIVE") // ACTIVE | ON_HOLD | INACTIVE
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  currency    Currency          @relation(fields: [currencyId], references: [id])
  quotations  SalesQuotation[]
  salesOrders SalesOrder[]
  deliveries  Delivery[]
  invoices    CustomerInvoice[]
  receipts    CustomerReceipt[]

  @@unique([companyId, customerNo])
  @@index([companyId, status])
}

model SalesQuotation {
  id                 String    @id @default(uuid())
  companyId          String
  branchId           String?
  quotationNo        String
  customerId         String
  quotationDate      DateTime  @db.Date
  validUntil         DateTime? @db.Date
  currencyId         String
  subtotal           Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal      Decimal   @default(0) @db.Decimal(18, 2)
  taxTotal           Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal         Decimal   @default(0) @db.Decimal(18, 2)
  status             String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | SENT | ACCEPTED | REJECTED | EXPIRED | CANCELLED
  workflowInstanceId String?   @unique
  decidedBy          String?
  decidedAt          DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency    Currency             @relation(fields: [currencyId], references: [id])
  lines       SalesQuotationLine[]
  salesOrders SalesOrder[]

  @@unique([companyId, quotationNo])
  @@index([companyId, status])
  @@index([customerId])
}

model SalesQuotationLine {
  id          String  @id @default(uuid())
  quotationId String
  productId   String?
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitId      String?
  unitPrice   Decimal @db.Decimal(18, 4)
  discount    Decimal @default(0) @db.Decimal(18, 4)
  taxAmount   Decimal @default(0) @db.Decimal(18, 2)
  lineTotal   Decimal @default(0) @db.Decimal(18, 2)

  quotation SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?       @relation("QuotationLines", fields: [productId], references: [id])

  @@index([quotationId])
}

model SalesOrder {
  id                    String    @id @default(uuid())
  companyId             String
  branchId              String?
  warehouseId           String?
  orderNo               String
  customerId            String
  quotationId           String?
  orderDate             DateTime  @db.Date
  requestedDeliveryDate DateTime? @db.Date
  currencyId            String
  paymentTermsId        String?
  subtotal              Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal         Decimal   @default(0) @db.Decimal(18, 2)
  taxTotal              Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal            Decimal   @default(0) @db.Decimal(18, 2)
  status                String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | PARTIALLY_DELIVERED | DELIVERED | INVOICED | CLOSED | CANCELLED
  workflowInstanceId    String?   @unique
  decidedBy             String?
  decidedAt             DateTime?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency   Currency          @relation(fields: [currencyId], references: [id])
  warehouse  Warehouse?        @relation(fields: [warehouseId], references: [id])
  quotation  SalesQuotation?   @relation(fields: [quotationId], references: [id])
  lines      SalesOrderLine[]
  deliveries Delivery[]
  invoices   CustomerInvoice[]

  @@unique([companyId, orderNo])
  @@index([companyId, status])
  @@index([customerId])
}

model SalesOrderLine {
  id                String  @id @default(uuid())
  salesOrderId      String
  productId         String?
  description       String
  quantity          Decimal @db.Decimal(18, 4)
  unitId            String?
  unitPrice         Decimal @db.Decimal(18, 4)
  discount          Decimal @default(0) @db.Decimal(18, 4)
  taxAmount         Decimal @default(0) @db.Decimal(18, 2)
  lineTotal         Decimal @default(0) @db.Decimal(18, 2)
  deliveredQuantity Decimal @default(0) @db.Decimal(18, 4)
  invoicedQuantity  Decimal @default(0) @db.Decimal(18, 4)

  salesOrder    SalesOrder            @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product       Product?              @relation("OrderLines", fields: [productId], references: [id])
  deliveryLines DeliveryLine[]
  invoiceLines  CustomerInvoiceLine[]

  @@index([salesOrderId])
}

model Delivery {
  id           String   @id @default(uuid())
  companyId    String
  branchId     String?
  warehouseId  String
  deliveryNo   String
  customerId   String
  salesOrderId String?
  deliveryDate DateTime @db.Date
  deliveredBy  String?
  status       String   @default("DRAFT") // DRAFT | POSTED | CANCELLED
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse  Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  lines      DeliveryLine[]
  currency   Currency?      @relation(fields: [currencyId], references: [id])
  currencyId String?

  @@unique([companyId, deliveryNo])
  @@index([companyId, status])
}

model DeliveryLine {
  id                  String  @id @default(uuid())
  deliveryId          String
  salesOrderLineId    String?
  productId           String?
  warehouseLocationId String?
  quantity            Decimal @db.Decimal(18, 4)
  unitId              String?
  batchNo             String?
  serialNo            String?

  delivery       Delivery           @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine?    @relation(fields: [salesOrderLineId], references: [id])
  product        Product?           @relation("DeliveryLines", fields: [productId], references: [id])
  location       WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])

  @@index([deliveryId])
}

model CustomerInvoice {
  id             String    @id @default(uuid())
  companyId      String
  branchId       String?
  invoiceNo      String
  customerId     String
  salesOrderId   String?
  deliveryId     String?
  invoiceDate    DateTime  @db.Date
  dueDate        DateTime  @db.Date
  currencyId     String
  subtotal       Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal  Decimal   @default(0) @db.Decimal(18, 2)
  taxTotal       Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal     Decimal   @default(0) @db.Decimal(18, 2)
  paidAmount     Decimal   @default(0) @db.Decimal(18, 2)
  status         String    @default("DRAFT") // DRAFT | APPROVED | POSTED | PARTIALLY_PAID | PAID | CANCELLED
  postingDate    DateTime?
  journalEntryId String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer    Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency    Currency              @relation(fields: [currencyId], references: [id])
  salesOrder  SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  lines       CustomerInvoiceLine[]
  allocations ReceiptAllocation[]

  @@unique([companyId, invoiceNo])
  @@index([companyId, status])
  @@index([customerId])
}

model CustomerInvoiceLine {
  id               String  @id @default(uuid())
  invoiceId        String
  salesOrderLineId String?
  productId        String?
  description      String
  quantity         Decimal @db.Decimal(18, 4)
  unitId           String?
  unitPrice        Decimal @db.Decimal(18, 4)
  discount         Decimal @default(0) @db.Decimal(18, 4)
  taxAmount        Decimal @default(0) @db.Decimal(18, 2)
  lineTotal        Decimal @default(0) @db.Decimal(18, 2)

  invoice        CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id])
  product        Product?        @relation("InvoiceLines", fields: [productId], references: [id])

  @@index([invoiceId])
}

model CustomerReceipt {
  id             String    @id @default(uuid())
  companyId      String
  branchId       String?
  receiptNo      String
  customerId     String
  receiptDate    DateTime  @db.Date
  currencyId     String
  amount         Decimal   @db.Decimal(18, 2)
  method         String // CASH | BANK_TRANSFER | CHECK | CARD | OTHER
  bankAccountRef String?
  reference      String?
  status         String    @default("POSTED") // POSTED | CANCELLED
  postedBy       String?
  postedAt       DateTime?
  journalEntryId String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency    Currency            @relation(fields: [currencyId], references: [id])
  allocations ReceiptAllocation[]

  @@unique([companyId, receiptNo])
  @@index([companyId, customerId])
}
model ReceiptAllocation {
  id              String  @id @default(uuid())
  receiptId       String
  invoiceId       String
  allocatedAmount Decimal @db.Decimal(18, 2)

  receipt CustomerReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Accounting (DATA-MODEL §13) — journals, GL
// ---------------------------------------------------------------------------

model JournalEntry {
  id                  String    @id @default(uuid())
  companyId           String
  branchId            String?
  journalNo           String
  journalType         String    @default("GENERAL") // GENERAL | SALES | PURCHASE | CASH | BANK | PAYROLL | INVENTORY | ASSET | TAX | ADJUSTMENT | REVERSAL
  journalDate         DateTime  @db.Date
  financialPeriodId   String?
  sourceType          String?
  sourceId            String?
  sourceDocumentNo    String?
  description         String?
  status              String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | POSTED | REVERSED | CANCELLED
  workflowInstanceId  String?   @unique
  postedById          String?
  postedAt            DateTime?
  reversedByJournalId String?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialPeriod FinancialPeriod? @relation(fields: [financialPeriodId], references: [id])
  reversedBy      JournalEntry?    @relation("JournalReversal", fields: [reversedByJournalId], references: [id])
  reverses        JournalEntry[]   @relation("JournalReversal")
  lines           JournalLine[]

  @@unique([companyId, journalNo])
  @@index([companyId, status])
  @@index([companyId, journalDate])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id            String   @id @default(uuid())
  journalId     String
  lineNo        Int
  accountId     String
  description   String?
  debit         Decimal  @default(0) @db.Decimal(18, 2)
  credit        Decimal  @default(0) @db.Decimal(18, 2)
  currencyId    String?
  exchangeRate  Decimal? @db.Decimal(18, 6)
  foreignDebit  Decimal? @db.Decimal(18, 2)
  foreignCredit Decimal? @db.Decimal(18, 2)
  customerId    String?
  supplierId    String?
  employeeId    String?
  productId     String?
  departmentId  String?
  costCenterId  String?

  journal JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product Product?     @relation("JournalLines", fields: [productId], references: [id])

  @@index([journalId])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Office (DATA-MODEL §22; PRD Stage 9)
// ---------------------------------------------------------------------------

model Visitor {
  id             String    @id @default(uuid())
  companyId      String
  branchId       String?
  visitorNo      String
  name           String
  companyName    String?
  phone          String?
  email          String?
  hostEmployeeId String?
  purpose        String?
  checkInAt      DateTime?
  checkOutAt     DateTime?
  status         String    @default("EXPECTED") // EXPECTED | CHECKED_IN | CHECKED_OUT | CANCELLED
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, visitorNo])
  @@index([companyId, status])
  @@index([companyId, checkInAt])
}

model CallLog {
  id                  String    @id @default(uuid())
  companyId           String
  branchId            String?
  callerName          String
  callerPhone         String?
  recipientEmployeeId String?
  subject             String
  notes               String?
  callTime            DateTime  @default(now())
  direction           String    @default("INBOUND") // INBOUND | OUTBOUND
  status              String    @default("OPEN") // OPEN | COMPLETED
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, callTime])
  @@index([companyId, status])
}

model Correspondence {
  id                 String    @id @default(uuid())
  companyId          String
  branchId           String?
  correspondenceNo   String
  direction          String // INCOMING | OUTGOING | INTERNAL
  correspondenceType String    @default("LETTER") // LETTER | EMAIL | FAX | PARCEL | OTHER
  sender             String
  recipient          String
  subject            String
  receivedAt         DateTime?
  sentAt             DateTime?
  assignedTo         String?
  status             String    @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  documentId         String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, correspondenceNo])
  @@index([companyId, status])
  @@index([companyId, direction])
}

model FileRecord {
  id                 String    @id @default(uuid())
  companyId          String
  branchId           String?
  fileNo             String
  title              String
  category           String?
  locationCode       String?
  status             String    @default("AVAILABLE") // AVAILABLE | ISSUED | ARCHIVED
  issuedToEmployeeId String?
  issuedAt           DateTime?
  dueAt              DateTime?
  returnedAt         DateTime?
  notes              String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  movements FileMovement[]

  @@unique([companyId, fileNo])
  @@index([companyId, status])
}

model FileMovement {
  id                 String   @id @default(uuid())
  fileId             String
  action             String // CREATED | ISSUED | RETURNED | ARCHIVED
  actorUserId        String
  issuedToEmployeeId String?
  note               String?
  at                 DateTime @default(now())

  file FileRecord @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId, at])
}

// ---------------------------------------------------------------------------
// Communication — Chat (DATA-MODEL §22; PRD Stage 10)
// ---------------------------------------------------------------------------

model Conversation {
  id            String    @id @default(uuid())
  companyId     String
  type          String    @default("GROUP") // DIRECT | GROUP
  name          String?
  createdById   String
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([companyId, type])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  role           String    @default("MEMBER") // OWNER | MEMBER
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderUserId   String
  messageType    String    @default("TEXT") // TEXT | SYSTEM
  content        String
  documentId     String?
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
